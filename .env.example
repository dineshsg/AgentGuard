# Copy this file to .env and fill in what you actually use.
# .env is gitignored — never commit real keys. src/llm_backend.py reads
# these at call time via os.environ; nothing is hardcoded anywhere in src/.

# Which backend the agents call by default. One of:
#   openai | litellm | ollama | lmstudio
LLM_PROVIDER=ollama

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LiteLLM (proxy/router in front of any provider) ---------------------
# LiteLLM can front OpenAI, Anthropic, Azure, Bedrock, etc. behind one
# OpenAI-compatible endpoint. Point it at your own LiteLLM proxy/server.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini

# --- Ollama (local) --------------------------------------------------------
# No key required for a local install. OLLAMA_API_KEY is only needed if
# you're pointing at a remote/hosted Ollama instance behind auth.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=

# --- LM Studio (local) ------------------------------------------------------
# LM Studio serves an OpenAI-compatible API locally. No key required by
# default; LMSTUDIO_API_KEY exists in case you've set one on the server.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=
